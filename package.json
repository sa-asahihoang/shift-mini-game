{
  "name": "shift-mini-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "audit:runs": "tsx --tsconfig tsconfig.json scripts/audit-runs.ts",
    "db:migrate": "tsx --tsconfig tsconfig.json scripts/migrate.ts",
    "build:scripts": "esbuild scripts/migrate.ts scripts/audit-runs.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist/scripts --tsconfig=tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "next": "16.3.0",
    "pino": "^10.3.1",
    "pixi.js": "^8.19.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.9.0",
    "tailwindcss": "^4",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
